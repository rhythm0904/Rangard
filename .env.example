# ── Copy this file to .env and fill in your values ──────────
# NEVER commit .env to git (it's already in .gitignore)

# ── App ────────────────────────────────────────────────────
APP_NAME=RANGARD
APP_ENV=development              # development | production
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database (PostgreSQL) ──────────────────────────────────
# Local dev:  postgresql+asyncpg://postgres:password@localhost:5432/rangard
# Production: get this from your cloud provider
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/rangard
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:password@localhost:5432/rangard

# ── Redis (for Celery task queue) ─────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT Auth ───────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Email (SendGrid) ───────────────────────────────────────
# Sign up free at sendgrid.com → Settings → API Keys
SENDGRID_API_KEY=SG.XXXXXXXXXXXXXXXXXXXX
EMAIL_FROM=alerts@yourdomain.com
EMAIL_FROM_NAME=RANGARD Security

# ── Blockchain (Ethereum via Infura) ──────────────────────
# Sign up free at infura.io → Create Project → Copy Project ID
INFURA_PROJECT_ID=your_infura_project_id_here
ETHEREUM_NETWORK=sepolia          # sepolia = testnet (free), mainnet = real money
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
WALLET_PRIVATE_KEY=0xYOUR_WALLET_PRIVATE_KEY   # never share this!

# ── File Storage (AWS S3) ──────────────────────────────────
# Or leave blank to use local disk storage during development
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=rangard-files

# ── IPFS (via Infura IPFS gateway) ────────────────────────
IPFS_PROJECT_ID=
IPFS_PROJECT_SECRET=

# ── Quarantine ────────────────────────────────────────────
QUARANTINE_DIR=/tmp/rangard_quarantine
MAX_FILE_SIZE_MB=50
